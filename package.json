{
  "name": "corporate-plugin-hub",
  "version": "0.1.0",
  "description": "Obsidian plugin: install and update company plugins from a Plugin Hub server",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test:e2e": "node --no-warnings test/e2e.mjs"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "builtin-modules": "^5.4.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.3"
  },
  "private": true
}
